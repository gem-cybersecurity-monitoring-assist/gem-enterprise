{
  "name": "gem-enterprise",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "video:worker": "tsx scripts/video-render-worker.ts",
    "video:worker:once": "tsx scripts/video-render-worker.ts --once",
    "video:worker:check": "tsx scripts/video-render-worker.ts --check",
    "claims:report": "tsx scripts/generate-public-claims-report.ts",
    "claims:check": "tsx scripts/generate-public-claims-report.ts --check",
    "db:schema:promote:auth": "node scripts/apply-auth-session-prisma.mjs",
    "db:schema:check:auth": "node scripts/apply-auth-session-prisma.mjs --check",
    "db:schema:promote:intake": "node scripts/apply-intake-prisma-models.mjs",
    "db:schema:check:intake": "node scripts/apply-intake-prisma-models.mjs --check",
    "db:schema:promote:requests": "node scripts/apply-service-request-prisma.mjs",
    "db:schema:check:requests": "node scripts/apply-service-request-prisma.mjs --check",
    "db:schema:promote:customer-success": "node scripts/apply-customer-success-prisma.mjs",
    "db:schema:check:customer-success": "node scripts/apply-customer-success-prisma.mjs --check",
    "db:schema:promote:communications": "node scripts/apply-communication-governance-prisma.mjs",
    "db:schema:check:communications": "node scripts/apply-communication-governance-prisma.mjs --check",
    "db:schema:promote": "pnpm run db:schema:promote:auth && pnpm run db:schema:promote:intake && pnpm run db:schema:promote:requests && pnpm run db:schema:promote:customer-success && pnpm run db:schema:promote:communications",
    "db:schema:check": "pnpm run db:schema:check:auth && pnpm run db:schema:check:intake && pnpm run db:schema:check:requests && pnpm run db:schema:check:customer-success && pnpm run db:schema:check:communications",
    "verify:preview": "pnpm run db:schema:check && pnpm run claims:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "verify": "pnpm run db:generate && pnpm run verify:preview && pnpm run build",
    "db:generate": "pnpm run db:schema:promote && prisma validate && prisma generate",
    "db:push": "pnpm run db:schema:promote && prisma validate && prisma db push",
    "db:migrate": "pnpm run db:schema:promote && prisma validate && prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "pnpm run db:schema:promote && prisma studio"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@supabase/supabase-js": "^2.110.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^6.0.300",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jose": "^5.9.6",
    "lucide-react": "^0.462.0",
    "next": "^16.3.8",
    "next-themes": "^0.3.0",
    "nodemailer": "^10.0.14",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.61.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "recharts": "^2.15.4",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.9",
    "zod": "^3.25.76"
  },
  "overrides": {
    "glob": "^10.5.0",
    "lodash": "^4.17.21"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@5": "^5.0.12",
      "js-yaml@4": "^4.3.2",
      "@babel/core@7": "^7.29.6",
      "postcss-selector-parser@6": "^6.1.3",
      "vitest>vite": "^8.0.16"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}
