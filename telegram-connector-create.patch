diff -ruN '--exclude=node_modules' '--exclude=tsconfig.tsbuildinfo' /tmp/gem-enterprise-pristine/src/__tests__/social-telegram-connector-create.test.ts telegram-connector-create/src/__tests__/social-telegram-connector-create.test.ts
