{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "ignoreCommand": "node scripts/vercel-ignore.mjs",
  "buildCommand": "pnpm run build",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install --frozen-lockfile",
  "regions": [
    "sfo1"
  ],
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/internal/recovery-readiness-watch",
      "schedule": "47 6 * * *"
    },
    {
      "path": "/api/social-media/orchestrator/daily/process",
      "schedule": "10 5 * * *"
    },
    {
      "path": "/api/social-media/publishing/jobs/process/07",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/social-media/publishing/jobs/process/08",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/social-media/publishing/jobs/process/09",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/social-media/publishing/jobs/process/10",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/social-media/publishing/jobs/process/11",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/social-media/publishing/jobs/process/12",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/social-media/publishing/jobs/process/13",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/social-media/publishing/jobs/process/14",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/social-media/publishing/jobs/process/15",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/social-media/publishing/jobs/process/16",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/social-media/publishing/jobs/process/17",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/social-media/publishing/jobs/process/18",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/social-media/publishing/jobs/process/19",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/social-media/publishing/jobs/process/20",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/social-media/publishing/jobs/process/21",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/social-media/publishing/jobs/process/22",
      "schedule": "0 22 * * *"
    }
  ],
  "env": {
    "NEXT_PUBLIC_APP_NAME": "GEM Enterprise",
    "NEXT_PUBLIC_APP_URL": "https://www.gemcybersecurityassist.com",
    "GEM_PUBLIC_APP_URL": "https://www.gemcybersecurityassist.com",
    "GEM_AGENT_API_BASE_URL": "https://support371-gem-enterprise.vercel.app",
    "GEM_VERIFY_SCANNER_MODE": "first_party",
    "GEM_VERIFY_SCANNER_URL": "https://www.gemcybersecurityassist.com/api/verify/evidence/internal-scanner",
    "GEM_VERIFY_PUBLIC_BASE_URL": "https://www.gemcybersecurityassist.com",
    "RUN_DB_MIGRATIONS": "false",
    "AUTO_DB_PUSH": "false",
    "AUTO_DB_SEED": "false",
    "SEED_DEMO_DATA": "false",
    "GEM_VERIFY_RETENTION_APPROVED": "false",
    "GEM_VERIFY_EVIDENCE_APPROVED": "false",
    "GEM_VERIFY_DOCUMENT_UPLOAD_ACTIVE": "false",
    "TIKTOK_SELLER_ACCOUNT_CONNECTED": "false",
    "GOOGLE_MERCHANT_ACCOUNT_CONNECTED": "false",
    "TOKMETRIC_LIVE_PUBLISHING_ENABLED": "false",
    "TOKMETRIC_SANDBOX_PUBLISHING_ENABLED": "false",
    "SOCIAL_MEDIA_LIVE_PUBLISHING_ENABLED": "false",
    "META_SOCIAL_PUBLISHING_ENABLED": "false",
    "X_SOCIAL_PUBLISHING_ENABLED": "false",
    "LINKEDIN_SOCIAL_PUBLISHING_ENABLED": "false",
    "YOUTUBE_PUBLISHING_ENABLED": "false",
    "NEXTDOOR_PUBLISHING_ENABLED": "false",
    "CONTENT_ORCHESTRATOR_PROVIDERS": "TIKTOK,FACEBOOK_PAGE,INSTAGRAM_PROFESSIONAL,X,NEXTDOOR",
    "CONTENT_ORCHESTRATOR_MINIMUM_TIKTOK_ITEMS": "20",
    "CONTENT_ORCHESTRATOR_OTHER_PROVIDER_ITEMS": "3",
    "SOCIAL_AUTOPILOT_ENABLED": "true",
    "SOCIAL_AUTOPILOT_AUTO_APPROVAL_ENABLED": "true",
    "SOCIAL_AUTOPILOT_RESERVE_DAYS": "3",
    "SOCIAL_AUTOPILOT_EGRESS_MODE": "PLATFORM_DEFAULT",
    "SOCIAL_AUTOPILOT_PROVIDERS": "FACEBOOK_PAGE,INSTAGRAM_PROFESSIONAL,X,LINKEDIN_COMPANY,YOUTUBE,NEXTDOOR",
    "SOCIAL_AUTOPILOT_FACEBOOK_PAGE_DAILY_TARGET": "3",
    "SOCIAL_AUTOPILOT_INSTAGRAM_PROFESSIONAL_DAILY_TARGET": "3",
    "SOCIAL_AUTOPILOT_X_DAILY_TARGET": "8",
    "SOCIAL_AUTOPILOT_LINKEDIN_COMPANY_DAILY_TARGET": "2",
    "SOCIAL_AUTOPILOT_YOUTUBE_DAILY_TARGET": "1",
    "SOCIAL_AUTOPILOT_NEXTDOOR_DAILY_TARGET": "1"
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": ".next"
}
